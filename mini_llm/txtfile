<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Performance Prediction - Enterprise Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        :root {
            --primary: #2563eb;
            --primary-dark: #1e40af;
            --secondary: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --dark: #1e293b;
            --light: #f8fafc;
            --border: #e2e8f0;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            color: var(--dark);
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        /* Server Status Badge */
        .server-status {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 1000;
            animation: slideIn 0.5s ease;
        }
        .server-status.online {
            background: #dcfce7;
            color: #15803d;
        }
        .server-status.offline {
            background: #fee2e2;
            color: #b91c1c;
        }
        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        .server-status.online .status-indicator {
            background: #22c55e;
        }
        .server-status.offline .status-indicator {
            background: #ef4444;
        }
        /* Header */
        .header {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: var(--shadow-lg);
            display: flex;
            justify-content: space-between;
            align-items: center;
            animation: slideDown 0.5s ease;
        }
        .header h1 {
            font-size: 28px;
            font-weight: 700;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header .icon {
            font-size: 32px;
        }
        .status-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: #dcfce7;
            color: #15803d;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        /* Navigation Tabs */
        .nav-tabs {
            background: white;
            border-radius: 16px;
            padding: 8px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .nav-tab {
            flex: 1;
            min-width: 200px;
            padding: 16px 24px;
            background: transparent;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .nav-tab:hover {
            background: var(--light);
            color: var(--primary);
        }
        .nav-tab.active {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: var(--shadow);
        }
        .nav-tab:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        /* Content Sections */
        .content-section {
            display: none;
            animation: fadeIn 0.5s ease;
        }
        .content-section.active {
            display: block;
        }
        /* Cards */
        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: var(--shadow-lg);
            animation: fadeInUp 0.5s ease;
            position: relative;
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--border);
        }
        .card-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--dark);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        /* Form Styles */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .form-label {
            font-size: 14px;
            font-weight: 600;
            color: var(--dark);
        }
        .form-input {
            padding: 12px 16px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: white;
        }
        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }
        .form-input:disabled {
            background: #f1f5f9;
            opacity: 0.6;
            cursor: not-allowed;
        }
        /* Buttons */
        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            box-shadow: var(--shadow);
        }
        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-secondary {
            background: #e2e8f0;
            color: var(--dark);
        }
        .btn-secondary:hover {
            background: #cbd5e1;
        }
        .btn-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
        }
        /* File Upload */
        .file-upload {
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: var(--light);
            position: relative;
        }
        .file-upload:hover {
            border-color: var(--primary);
            background: #eff6ff;
        }
        .file-upload.dragover {
            border-color: var(--primary);
            background: #eff6ff;
            transform: scale(1.02);
        }
        .file-upload input[type="file"] {
            position: absolute;
            width: 0;
            height: 0;
            opacity: 0;
        }
        /* Results Grid */
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }
        .result-card {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            border-radius: 12px;
            padding: 20px;
            border-left: 4px solid var(--primary);
            transition: all 0.3s ease;
        }
        .result-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        .result-card.success {
            border-left-color: var(--secondary);
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        }
        .result-card.warning {
            border-left-color: var(--warning);
            background: linear-gradient(135deg, #fffbeb, #fef3c7);
        }
        .result-card.danger {
            border-left-color: var(--danger);
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
        }
        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: white;
            padding: 24px;
            border-radius: 12px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }
        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .stat-icon.primary {
            background: linear-gradient(135deg, #dbeafe, #bfdbfe);
            color: var(--primary);
        }
        .stat-icon.success {
            background: linear-gradient(135deg, #dcfce7, #bbf7d0);
            color: var(--secondary);
        }
        .stat-icon.warning {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            color: var(--warning);
        }
        .stat-icon.danger {
            background: linear-gradient(135deg, #fee2e2, #fecaca);
            color: var(--danger);
        }
        .stat-content h3 {
            font-size: 28px;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 4px;
        }
        .stat-content p {
            font-size: 14px;
            color: #64748b;
        }
        /* Table */
        .table-container {
            overflow-x: auto;
            border-radius: 12px;
            box-shadow: var(--shadow);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }
        thead {
            background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
        }
        th {
            padding: 16px;
            text-align: left;
            font-weight: 700;
            color: var(--dark);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        td {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            font-size: 14px;
        }
        tbody tr:hover {
            background: var(--light);
        }
        /* Badge */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            gap: 6px;
        }
        .badge.success {
            background: #dcfce7;
            color: #15803d;
        }
        .badge.danger {
            background: #fee2e2;
            color: #b91c1c;
        }
        .badge.warning {
            background: #fef3c7;
            color: #b45309;
        }
        .badge.info {
            background: #dbeafe;
            color: #1e40af;
        }
        /* Loading Spinner */
        .spinner {
            display: none;
            width: 50px;
            height: 50px;
            border: 4px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 40px auto;
        }
        .spinner.active {
            display: block;
        }
        /* Progress Bar */
        .progress-bar {
            height: 8px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border-radius: 10px;
            transition: width 0.3s ease;
        }
        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        /* Alert Box */
        .alert {
            padding: 16px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            animation: fadeIn 0.3s ease;
        }
        .alert-success {
            background: #dcfce7;
            color: #15803d;
            border-left: 4px solid #22c55e;
        }
        .alert-error {
            background: #fee2e2;
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }
        .alert-info {
            background: #dbeafe;
            color: #1e40af;
            border-left: 4px solid #3b82f6;
        }
        .alert-warning {
            background: #fef3c7;
            color: #b45309;
            border-left: 4px solid #f59e0b;
        }
        .confidence-bar {
            height: 6px;
            background: var(--border);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 12px;
        }
        .confidence-fill {
            height: 100%;
            border-radius: 10px;
            transition: width 0.5s ease;
        }
        .confidence-fill.high {
            background: linear-gradient(90deg, #10b981, #059669);
        }
        .confidence-fill.medium {
            background: linear-gradient(90deg, #f59e0b, #d97706);
        }
        .confidence-fill.low {
            background: linear-gradient(90deg, #ef4444, #dc2626);
        }
        /* Responsive */
        @media (max-width: 768px) {
            .header {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }
            .nav-tabs {
                flex-direction: column;
            }
            .nav-tab {
                width: 100%;
            }
            .form-grid {
                grid-template-columns: 1fr;
            }
            .server-status {
                position: static;
                margin-bottom: 20px;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <!-- Server Status -->
    <div class="server-status offline" id="serverStatus">
        <div class="status-indicator"></div>
        <span>Checking server...</span>
    </div>
    <div class="container">
        <div class="header">
            <h1>
                <span class="icon">📊</span>
                Product Performance Prediction Platform
            </h1>
            <div class="status-badge">
                <span class="status-dot"></span>
                <span id="headerStatus">Connecting...</span>
            </div>
        </div>
        <div class="nav-tabs">
            <button class="nav-tab active" onclick="showTab('financing', this)" id="tabFinancing">
                <span>💰</span> Financing Recommendations
            </button>
            <button class="nav-tab" onclick="showTab('dealid', this)" id="tabDealid">
                <span>🔍</span> Search by Deal ID
            </button>
            <button class="nav-tab" onclick="showTab('batch', this)" id="tabBatch">
                <span>📁</span> Batch Analysis
            </button>
        </div>
        <div id="notificationArea"></div>
        <!-- Financing Tab -->
        <div id="financing" class="content-section active">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <span>💰</span>
                        Get Product Recommendations Based on Financing
                    </h2>
                </div>
                <form id="financingForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Amount Financed ($)</label>
                            <input type="number" class="form-input" id="amount_financed"
                                   value="21781.58" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Down Payment ($)</label>
                            <input type="number" class="form-input" id="down_payment"
                                   value="0" step="0.01">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Interest Rate (%)</label>
                            <input type="number" class="form-input" id="interest_rate"
                                   value="4.5" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Term (Months)</label>
                            <input type="number" class="form-input" id="term_months"
                                   value="72" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Lender Code</label>
                            <input type="text" class="form-input" id="lender_code"
                                   value="T72C4000">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="financingSubmit">
                        <span>🚀</span> Get Recommendations
                    </button>
                </form>
                <div class="spinner" id="financingSpinner"></div>
                <div id="financingResults" style="display: none;">
                    <div class="stats-grid" id="financingStats"></div>
                    <h3 style="margin: 30px 0 20px; font-size: 20px;">
                        <span>⭐</span> Recommended Products
                    </h3>
                    <div class="results-grid" id="recommendedProducts"></div>
                    <div class="card" style="margin-top: 30px;" id="marketInsights"></div>
                </div>
            </div>
        </div>
        <!-- Deal ID Tab -->
        <div id="dealid" class="content-section">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <span>🔍</span>
                        Search Deal by ID
                    </h2>
                </div>
                <form id="dealIdForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Enter Deal ID</label>
                            <input type="text" class="form-input" id="deal_id_input"
                                   placeholder="e.g., 15" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary" id="dealIdSubmit">
                        <span>🔍</span> Search Deal
                    </button>
                </form>
                <div class="spinner" id="dealIdSpinner"></div>
                <div id="dealIdResults" style="display: none;">
                    <div class="table-container">
                        <table id="dealIdTable"></table>
                    </div>
                    <p id="dealIdSummary" style="margin-top: 20px; font-size: 16px; font-weight: 600;"></p>
                </div>
            </div>
        </div>
        <!-- Batch Analysis Tab -->
        <div id="batch" class="content-section">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">
                        <span>📁</span>
                        Batch CSV Analysis
                    </h2>
                </div>
                <form id="batchForm">
                    <div class="file-upload" id="fileUploadArea">
                        <input type="file" id="csvFile" accept=".csv" required>
                        <div style="font-size: 48px; margin-bottom: 16px;">📤</div>
                        <h3 style="font-size: 18px; margin-bottom: 8px;">
                            Upload CSV File
                        </h3>
                        <p style="color: #64748b; font-size: 14px;">
                            Click to browse or drag and drop your CSV file here
                        </p>
                        <p id="fileName" style="margin-top: 12px; color: var(--primary); font-weight: 600;">
                            No file selected.
                        </p>
                    </div>
                    <button type="submit" class="btn btn-primary" style="margin-top: 20px;" id="batchSubmit" disabled>
                        <span>📊</span> Analyze Batch
                    </button>
                    <a href="#" id="downloadBatchResults" class="btn btn-success" style="margin-top: 20px; display: none;" download="prediction_results.csv">
                        <span>⬇️</span> Download Results CSV
                    </a>
                </form>
                <div class="spinner" id="batchSpinner"></div>
                <div id="batchResults" style="display: none;">
                    <div class="stats-grid" id="batchStats"></div>
                    <h3 style="margin: 30px 0 20px; font-size: 20px;">
                        <span>🔥</span> Top 100 Selling Fast Predictions
                    </h3>
                    <div class="table-container">
                        <table id="batchTable"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        // Configuration
        const API_BASE_URL = 'http://localhost:8000';
        let serverOnline = false;

        // ==================== SERVER HEALTH CHECK ====================
        async function checkServerStatus() {
            try {
                const response = await fetch(`${API_BASE_URL}/`, {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    serverOnline = true;
                    updateServerStatus(true);
                    return true;
                } else {
                    throw new Error('Server returned error');
                }
            } catch (error) {
                serverOnline = false;
                updateServerStatus(false);
                return false;
            }
        }

        function updateServerStatus(isOnline) {
            const statusElement = document.getElementById('serverStatus');
            const headerStatus = document.getElementById('headerStatus');
            const tabs = document.querySelectorAll('.nav-tab');
            if (isOnline) {
                statusElement.classList.remove('offline');
                statusElement.classList.add('online');
                statusElement.innerHTML = `
                    <div class="status-indicator"></div>
                    <span>Python Server Online ✅</span>
                `;
                headerStatus.textContent = 'Server Online ✅';
                tabs.forEach(tab => tab.disabled = false);
            } else {
                statusElement.classList.remove('online');
                statusElement.classList.add('offline');
                statusElement.innerHTML = `
                    <div class="status-indicator"></div>
                    <span>Python Server Offline ❌</span>
                `;
                headerStatus.textContent = 'Server Offline - Read-Only Mode';
                tabs.forEach(tab => tab.disabled = true);
                showAlert('error', '⚠️ Python server is not running. Please start the Python API server at http://localhost:8000');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            checkServerStatus();
            setInterval(checkServerStatus, 10000);
        });

        // ==================== UTILITY FUNCTIONS ====================
        function showAlert(type, message) {
            const notificationArea = document.getElementById('notificationArea');
            notificationArea.innerHTML = '';
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type}`;
            alertDiv.innerHTML = `
                <span style="font-size: 20px;">${
                    type === 'success' ? '✅' :
                    type === 'error' ? '❌' :
                    type === 'warning' ? '⚠️' : 'ℹ️'
                }</span>
                <span>${message}</span>
            `;
            notificationArea.appendChild(alertDiv);
            setTimeout(() => {
                alertDiv.style.opacity = 0;
                setTimeout(() => alertDiv.remove(), 300);
            }, 5000);
        }

        // ==================== TAB NAVIGATION ====================
        function showTab(tabName, element) {
            if (!serverOnline && tabName !== 'financing') {
                showAlert('error', '⚠️ Python server is offline. Please start the API server to use this feature.');
                return;
            }
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            document.getElementById(tabName).classList.add('active');
            element.classList.add('active');
            document.getElementById('financingResults').style.display = 'none';
            document.getElementById('dealIdResults').style.display = 'none';
            document.getElementById('batchResults').style.display = 'none';
            document.getElementById('downloadBatchResults').style.display = 'none';
        }

        // ==================== FILE UPLOAD HANDLER WITH DRAG & DROP ====================
        const fileUploadArea = document.getElementById('fileUploadArea');
        const csvFileInput = document.getElementById('csvFile');
        const batchSubmitBtn = document.getElementById('batchSubmit');

        // Click to upload
        fileUploadArea.addEventListener('click', (e) => {
            // Prevent triggering if clicking the actual file input
            if (e.target.tagName !== 'INPUT') {
                csvFileInput.click();
            }
        });

        // Drag and drop
        fileUploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.stopPropagation();
            fileUploadArea.classList.add('dragover');
        });

        fileUploadArea.addEventListener('dragleave', (e) => {
            e.preventDefault();
            e.stopPropagation();
            fileUploadArea.classList.remove('dragover');
        });

        fileUploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            e.stopPropagation();
            fileUploadArea.classList.remove('dragover');
            
            if (e.dataTransfer.files.length > 0) {
                const file = e.dataTransfer.files[0];
                
                // Validate file type
                if (!file.name.toLowerCase().endsWith('.csv')) {
                    showAlert('error', '❌ Please upload a CSV file only.');
                    return;
                }
                
                // Create a new FileList-like object
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                csvFileInput.files = dataTransfer.files;
                
                updateFileName();
            }
        });

        // File input change
        csvFileInput.addEventListener('change', (e) => {
            if (csvFileInput.files.length > 0) {
                const file = csvFileInput.files[0];
                
                // Validate file type
                if (!file.name.toLowerCase().endsWith('.csv')) {
                    showAlert('error', '❌ Please upload a CSV file only.');
                    csvFileInput.value = ''; // Clear the input
                    updateFileName();
                    return;
                }
                
                // Validate file size (max 10MB)
                if (file.size > 10 * 1024 * 1024) {
                    showAlert('error', '❌ File size exceeds 10MB. Please upload a smaller file.');
                    csvFileInput.value = ''; // Clear the input
                    updateFileName();
                    return;
                }
                
                updateFileName();
            }
        });

        function updateFileName() {
            const fileNameDisplay = document.getElementById('fileName');
            const downloadButton = document.getElementById('downloadBatchResults');
            
            if (csvFileInput.files.length > 0) {
                const fileName = csvFileInput.files[0].name;
                const fileSize = (csvFileInput.files[0].size / 1024).toFixed(2);
                fileNameDisplay.innerHTML = `✅ <strong>${fileName}</strong> (${fileSize} KB)`;
                fileNameDisplay.style.color = 'var(--secondary)';
                batchSubmitBtn.disabled = false;
                downloadButton.style.display = 'none';
            } else {
                fileNameDisplay.textContent = 'No file selected.';
                fileNameDisplay.style.color = '#64748b';
                batchSubmitBtn.disabled = true;
            }
        }

        // ==================== BATCH ANALYSIS HANDLER ====================
        document.getElementById('batchForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if (!serverOnline) {
                showAlert('error', '⚠️ Python server is offline. Cannot fetch data. Please start the API server.');
                return;
            }

            const spinner = document.getElementById('batchSpinner');
            const resultsDiv = document.getElementById('batchResults');
            const downloadButton = document.getElementById('downloadBatchResults');

            if (csvFileInput.files.length === 0) {
                showAlert('error', '❌ Please select a CSV file for batch analysis.');
                return;
            }

            const file = csvFileInput.files[0];
            
            // Validate file
            if (!file.name.toLowerCase().endsWith('.csv')) {
                showAlert('error', '❌ Please upload a CSV file only.');
                return;
            }

            spinner.classList.add('active');
            resultsDiv.style.display = 'none';
            downloadButton.style.display = 'none';
            batchSubmitBtn.disabled = true;

            const formData = new FormData();
            formData.append('file', file);

            try {
                console.log('Uploading file:', file.name);
                
                const response = await fetch(`${API_BASE_URL}/predict/batch`, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                console.log('API Response:', result);

                if (response.ok) {
                    displayBatchResults(result);
                    showAlert('success', `✅ Batch analysis complete. ${result.total_predictions} records processed.`);
                    
                    // Setup download
                    const downloadFormData = new FormData();
                    downloadFormData.append('file', file);
                    
                    const downloadResponse = await fetch(`${API_BASE_URL}/predict/download`, {
                        method: 'POST',
                        body: downloadFormData
                    });
                    
                    if (downloadResponse.ok) {
                        const blob = await downloadResponse.blob();
                        const url = window.URL.createObjectURL(blob);
                        downloadButton.href = url;
                        downloadButton.download = 'prediction_results.csv';
                        downloadButton.style.display = 'inline-flex';
                    }
                } else {
                    showAlert('error', `❌ API Error: ${result.detail || 'An unknown error occurred.'}`);
                }
            } catch (error) {
                showAlert('error', `❌ Connection Error: ${error.message}`);
                console.error('Batch upload error:', error);
            } finally {
                spinner.classList.remove('active');
                batchSubmitBtn.disabled = false;
            }
        });

        function displayBatchResults(data) {
            const resultsDiv = document.getElementById('batchResults');
            const statsDiv = document.getElementById('batchStats');
            const table = document.getElementById('batchTable');

            resultsDiv.style.display = 'block';

            statsDiv.innerHTML = `
                <div class="stat-card">
                    <div class="stat-icon primary"><span>∑</span></div>
                    <div class="stat-content">
                        <h3>${data.total_predictions}</h3>
                        <p>Total Records Analyzed</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon success"><span>🔥</span></div>
                    <div class="stat-content">
                        <h3>${data.selling_fast_count}</h3>
                        <p>Predicted Selling Fast</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon warning"><span>🎯</span></div>
                    <div class="stat-content">
                        <h3>${(data.selling_fast_count / data.total_predictions * 100).toFixed(1)}%</h3>
                        <p>Selling Fast Percentage</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon danger"><span>⭐</span></div>
                    <div class="stat-content">
                        <h3>${data.average_confidence.toFixed(2)}</h3>
                        <p>Avg. Confidence</p>
                    </div>
                </div>
            `;

            let tableHTML = `
                <thead>
                    <tr>
                        <th>Deal ID</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Rate/Term</th>
                        <th>Prediction</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
            `;

            if (data.top_predictions && data.top_predictions.length > 0) {
                data.top_predictions.forEach(p => {
                    const badgeClass = p.selling_fast ? 'success' : 'danger';
                    const predictionLabel = p.selling_fast ? 'SELLING FAST ⭐' : 'Not Likely';
                    tableHTML += `
                        <tr>
                            <td>${p.deal_id || p.dealid || 'N/A'}</td>
                            <td>${p.product_name || p.productname || 'N/A'}</td>
                            <td><span class="badge info">${p.product_category || p.productcategory || 'N/A'}</span></td>
                            <td>$${(p.selling_price || p.sellingprice || 0).toFixed(2)}</td>
                            <td>${(p.rate || p.pcrate || 0).toFixed(2)}% / ${p.term || p.pcterm || 0}mo</td>
                            <td><span class="badge ${badgeClass}">${predictionLabel}</span></td>
                            <td>${((p.confidence || 0) * 100).toFixed(1)}%</td>
                        </tr>
                    `;
                });
            } else {
                tableHTML += `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px;">
                            <span style="font-size: 48px;">📭</span><br>
                            <strong>No predictions available</strong>
                        </td>
                    </tr>
                `;
            }

            tableHTML += '</tbody>';
            table.innerHTML = tableHTML;
        }

        // ==================== FINANCING FORM HANDLER ====================
        document.getElementById('financingForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!serverOnline) {
                showAlert('error', '⚠️ Python server is offline. Cannot fetch data. Please start the API server.');
                return;
            }

            const spinner = document.getElementById('financingSpinner');
            const resultsDiv = document.getElementById('financingResults');

            spinner.classList.add('active');
            resultsDiv.style.display = 'none';

            try {
                const financing = {
                    amount_financed: parseFloat(document.getElementById('amount_financed').value),
                    down_payment: parseFloat(document.getElementById('down_payment').value),
                    interest_rate: parseFloat(document.getElementById('interest_rate').value),
                    term_months: parseInt(document.getElementById('term_months').value),
                    lender_code: document.getElementById('lender_code').value
                };

                const response = await fetch(`${API_BASE_URL}/predict/by-financing`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(financing)
                });

                const result = await response.json();
                if (response.ok) {
                    displayFinancingResults(result);
                    showAlert('success', `✅ Found ${result.total_recommendations} recommended products.`);
                } else {
                    showAlert('error', `❌ API Error: ${result.detail || 'An error occurred.'}`);
                }
            } catch (error) {
                showAlert('error', `❌ Connection Error: ${error.message}`);
            } finally {
                spinner.classList.remove('active');
            }
        });

        function displayFinancingResults(data) {
            const statsDiv = document.getElementById('financingStats');
            const productsDiv = document.getElementById('recommendedProducts');
            const insightsDiv = document.getElementById('marketInsights');
            const resultsDiv = document.getElementById('financingResults');

            resultsDiv.style.display = 'block';

            statsDiv.innerHTML = `
                <div class="stat-card">
                    <div class="stat-icon primary"><span>💵</span></div>
                    <div class="stat-content">
                        <h3>$${(data.calculated_metrics.monthly_payment || 0).toFixed(2)}</h3>
                        <p>Monthly Payment</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon success"><span>⭐</span></div>
                    <div class="stat-content">
                        <h3>${data.total_recommendations}</h3>
                        <p>Products Recommended</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon warning"><span>🎯</span></div>
                    <div class="stat-content">
                        <h3>${data.high_confidence_products}</h3>
                        <p>High Confidence</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon danger"><span>💰</span></div>
                    <div class="stat-content">
                        <h3>$${(data.calculated_metrics.total_interest || 0).toFixed(2)}</h3>
                        <p>Total Interest</p>
                    </div>
                </div>
            `;

            productsDiv.innerHTML = (data.recommended_products || []).slice(0, 5).map(product => {
                const confidenceClass = product.confidence > 0.8 ? 'high' :
                                      product.confidence > 0.6 ? 'medium' : 'low';
                const cardClass = product.confidence > 0.8 ? 'success' :
                                 product.confidence > 0.6 ? 'warning' : 'danger';
                return `
                    <div class="result-card ${cardClass}">
                        <h3 style="font-size: 18px; margin-bottom: 8px; color: var(--dark);">
                            ${product.product_name}
                        </h3>
                        <div class="badge ${cardClass}">
                            ${product.product_category}
                        </div>
                        <div style="margin: 16px 0;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-size: 13px; color: #64748b;">Confidence</span>
                                <span style="font-weight: 700; color: var(--dark);">
                                    ${(product.confidence * 100).toFixed(1)}%
                                </span>
                            </div>
                            <div class="confidence-bar">
                                <div class="confidence-fill ${confidenceClass}"
                                     style="width: ${product.confidence * 100}%"></div>
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0;">
                            <div>
                                <p style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Cost</p>
                                <p style="font-weight: 700; color: var(--dark);">
                                    $${(product.recommended_cost || 0).toFixed(2)}
                                </p>
                            </div>
                            <div>
                                <p style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Selling Price</p>
                                <p style="font-weight: 700; color: var(--dark);">
                                    $${(product.recommended_selling_price || 0).toFixed(2)}
                                </p>
                            </div>
                            <div>
                                <p style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Profit</p>
                                <p style="font-weight: 700; color: var(--secondary);">
                                    $${(product.expected_profit_margin || 0).toFixed(2)}
                                </p>
                            </div>
                            <div>
                                <p style="font-size: 12px; color: #64748b; margin-bottom: 4px;">Margin %</p>
                                <p style="font-weight: 700; color: var(--secondary);">
                                    ${(product.expected_profit_margin_pct || 0).toFixed(1)}%
                                </p>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            insightsDiv.innerHTML = `
                <h2 class="card-title">
                    <span>💡</span> Market Insights
                </h2>
                <div style="margin-top: 16px;">
                    <p style="font-size: 15px; color: #64748b; margin-bottom: 12px;">
                        <strong>Financing Profile:</strong> ${(data.market_insights.financing_profile) || 'N/A'}
                    </p>
                    <p style="font-size: 15px; color: #64748b; margin-bottom: 12px;">
                        <strong>Deal Attractiveness:</strong> ${(data.market_insights.deal_attractiveness) || 'N/A'}
                    </p>
                    <p style="font-size: 15px; color: #64748b;">
                        <strong>Recommended Strategy:</strong> ${(data.market_insights.recommended_strategy) || 'N/A'}
                    </p>
                </div>
            `;
        }

        // ==================== DEAL ID SEARCH HANDLER ====================
        document.getElementById('dealIdForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!serverOnline) {
                showAlert('error', '⚠️ Python server is offline. Cannot fetch data. Please start the API server.');
                return;
            }

            const spinner = document.getElementById('dealIdSpinner');
            const resultsDiv = document.getElementById('dealIdResults');
            const dealId = document.getElementById('deal_id_input').value;

            spinner.classList.add('active');
            resultsDiv.style.display = 'none';

            try {
                const response = await fetch(`${API_BASE_URL}/predict/deal/${dealId}`, {
                    method: 'GET'
                });

                const result = await response.json();
                if (response.ok) {
                    displayDealResults(result, dealId);
                    showAlert('success', `✅ Found deal ${dealId}.`);
                } else {
                    showAlert('error', `❌ Deal not found or error: ${result.detail || 'Unknown error'}`);
                }
            } catch (error) {
                showAlert('error', `❌ Connection Error: ${error.message}`);
            } finally {
                spinner.classList.remove('active');
            }
        });

        function displayDealResults(data, dealId) {
            const table = document.getElementById('dealIdTable');
            const summary = document.getElementById('dealIdSummary');
            const resultsDiv = document.getElementById('dealIdResults');

            resultsDiv.style.display = 'block';

            summary.innerHTML = `
                Deal ID: <strong>${dealId}</strong> |
                Dealership: <strong>${data.dealership_name || 'N/A'}</strong> |
                Status: <strong>${(data.overall_prediction?.summary) || 'N/A'}</strong>
            `;

            let tableHTML = `
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Cost ($)</th>
                        <th>Selling Price ($)</th>
                        <th>Prediction</th>
                        <th>Confidence</th>
                    </tr>
                </thead>
                <tbody>
            `;

            if (data.products && Array.isArray(data.products)) {
                data.products.forEach(p => {
                    const badgeClass = p.will_sell_fast ? 'success' : 'danger';
                    const predictionLabel = p.will_sell_fast ? 'SELLING FAST 🔥' : 'Not Likely';
                    tableHTML += `
                        <tr>
                            <td>${p.product_name || 'N/A'}</td>
                            <td><span class="badge info">${p.product_category || 'N/A'}</span></td>
                            <td>$${(p.cost || 0).toFixed(2)}</td>
                            <td>$${(p.selling_price || 0).toFixed(2)}</td>
                            <td><span class="badge ${badgeClass}">${predictionLabel}</span></td>
                            <td>${((p.confidence || 0) * 100).toFixed(1)}%</td>
                        </tr>
                    `;
                });
            }

            tableHTML += '</tbody>';
            table.innerHTML = tableHTML;
        }

        // Initialize on page load
        updateFileName();
    </script>
</body>
</html>

