      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Using a seeder, create a new dealership variable and available variable for toggling the Customer Loan Details through Lending Platform functionality."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Dealership Variable: "
            },
            {
              "type": "text",
              "text": "a2z_lending_platform_cld",
              "marks": [
                {
                  "type": "code"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Description: "
            },
            {
              "type": "text",
              "text": "Enables the Customer Loan Details (merged LLL/LLF) through Lending Platform feature",
              "marks": [
                {
                  "type": "code"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Default: "
            },
            {
              "type": "text",
              "text": "false",
              "marks": [
                {
                  "type": "code"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Client Editable = NO"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "type = boolean"
            }
          ]
        }
      ]
    },
